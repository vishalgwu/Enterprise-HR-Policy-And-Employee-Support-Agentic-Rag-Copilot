# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Which keys are required depends on the providers chosen below. Everything else
# has a working default, and the app starts without the keys so /health can
# report which are missing by name.

# --- Application -------------------------------------------------------------
# APP_ENV=production withholds /docs, /redoc and /openapi.json, and makes
# ADMIN_API_KEY mandatory at startup.
# APP_NAME=Enterprise HR Policy Agentic RAG Copilot
# APP_ENV=development

# Gates the admin-only endpoints (/upload, /ingest, /admin, /logs).
#
# Leave it unset and admin is OFF -- every such request is refused. That is the
# point: a working placeholder default would mean forgetting to set it leaves
# the admin API open behind a string published in the source. Generate a real
# one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# --- Paths -------------------------------------------------------------------
# Absolute paths, so a container can mount them as volumes.
# KB_DIR=/app/data/private_kb
# UPLOAD_DIR=/app/uploads
# AUDIT_DB_PATH=/app/data/audit.db

# https://console.groq.com/keys
GROQ_API=<your-groq-api-key>

# https://app.tavily.com
TAVILY_API=<your-tavily-api-key>

# https://app.pinecone.io
PINECONE_API=<your-pinecone-api-key>

# Required only when a provider below is set to openai.
# OPENAI_API_KEY=<your-openai-api-key>

# --- Providers ---------------------------------------------------------------
# Chosen independently. /health reports which ones a deployment resolved to,
# and missing_secrets only asks for the keys the chosen providers need.
#
#   LLM_PROVIDER=groq        default. Fast and cheap; free tier caps tokens/day.
#   LLM_PROVIDER=openai      uses OPENAI_MODEL.
#
#   EMBEDDING_PROVIDER=huggingface   default. all-MiniLM-L6-v2, runs locally:
#                                    no per-query cost, and no employee question
#                                    leaves the machine at embed time. Needs
#                                    torch (~2.5 GB installed).
#   EMBEDDING_PROVIDER=openai        calls the API. The only option on a host
#                                    that cannot ship torch -- a Vercel function
#                                    is far under the size needed.
#
# IMPORTANT: the two embedding providers emit different vector widths (384 vs
# 1536) and Pinecone cannot resize an index. Each provider therefore needs its
# OWN PINECONE_INDEX, ingested separately. Settings refuses a dimension that
# contradicts the model rather than letting it fail inside Pinecone.
# LLM_PROVIDER=groq
# EMBEDDING_PROVIDER=huggingface
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=0

# The index is created automatically on first run (384-d, cosine, serverless).
PINECONE_INDEX=peopleprime-hr-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Namespaces. Writer and reader read the same value, so changing one of these
# means re-ingesting -- a mismatch is silent, because the upsert succeeds and
# every later retrieval simply returns [].
# PRIVATE_NAMESPACE=hr-docs
# PUBLIC_NAMESPACE=public-web

# Optional overrides -- all have working defaults. Set them explicitly in a
# deployment so the running configuration is readable from the environment
# rather than inferred from the code.
# GROQ_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# API_HOST=0.0.0.0
# API_PORT=8000

# --- Observability -----------------------------------------------------------
# LangSmith tracing is OFF unless LANGSMITH_TRACING is true AND a key is set.
# /health reports both whether tracing is on and whether it is redacted.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=<your-langsmith-key>
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=hr-copilot

# Payload redaction, ON by default and the reason tracing is safe to enable
# here. Without it every trace uploads the employee's question and the retrieved
# policy text to LangChain. With it you still get the run tree, timings, routing
# and grading decisions, token counts and errors -- everything needed to debug
# the agent -- and no HR content.
#
# Turn them off only to debug a specific answer, and turn them back on.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Note: OPENAI_API_KEY is only forwarded to the process environment when
# LLM_PROVIDER or EMBEDDING_PROVIDER is set to openai. A key left here while
# both providers are their defaults stays unused -- it is never exported, so
# langchain-openai (installed as a langchain-pinecone dependency) cannot pick
# it up on its own.
