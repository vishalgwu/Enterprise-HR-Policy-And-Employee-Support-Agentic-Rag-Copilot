# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Which keys are required depends on the providers chosen below. Everything else
# has a working default, and the app starts without the keys so /health can
# report which are missing by name.

# --- Application -------------------------------------------------------------
# APP_ENV=production withholds /docs, /redoc and /openapi.json, and makes
# ADMIN_API_KEY mandatory at startup.
# APP_NAME=Enterprise HR Policy Agentic RAG Copilot
# APP_ENV=development

# Gates the admin-only endpoints (/upload, /ingest, /admin, /logs).
#
# Leave it unset and admin is OFF -- every such request is refused. That is the
# point: a working placeholder default would mean forgetting to set it leaves
# the admin API open behind a string published in the source. Generate a real
# one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# --- Paths -------------------------------------------------------------------
# Absolute paths, so a container can mount them as volumes.
# KB_DIR=/app/data/private_kb
# UPLOAD_DIR=/app/uploads
# AUDIT_DB_PATH=/app/data/audit.db

# --- Uploads -----------------------------------------------------------------
# Cap on one /api/upload body, enforced while it streams to disk. Default 10.
# MAX_UPLOAD_MB=10

# https://console.groq.com/keys
GROQ_API=<your-groq-api-key>

# https://app.tavily.com
TAVILY_API=<your-tavily-api-key>

# https://app.pinecone.io
PINECONE_API=<your-pinecone-api-key>

# Required only when a provider below is set to openai.
# OPENAI_API_KEY=<your-openai-api-key>

# --- Providers ---------------------------------------------------------------
# Chosen independently. /health reports which ones a deployment resolved to,
# and missing_secrets only asks for the keys the chosen providers need.
#
#   LLM_PROVIDER=groq        default. Fast and cheap; free tier caps tokens/day.
#   LLM_PROVIDER=openai      uses OPENAI_MODEL.
#
#   EMBEDDING_PROVIDER=huggingface   default. all-MiniLM-L6-v2, runs locally:
#                                    no per-query cost, and no employee question
#                                    leaves the machine at embed time. Needs
#                                    torch (~2.5 GB installed).
#   EMBEDDING_PROVIDER=openai        calls the API. The only option on a host
#                                    that cannot ship torch -- a Vercel function
#                                    is far under the size needed.
#
# IMPORTANT: the two embedding providers emit different vector widths (384 vs
# 1536) and Pinecone cannot resize an index. Each provider therefore needs its
# OWN PINECONE_INDEX, ingested separately. Settings refuses a dimension that
# contradicts the model rather than letting it fail inside Pinecone.
# LLM_PROVIDER=groq
# EMBEDDING_PROVIDER=huggingface
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=0

# The index is created automatically on first run (384-d, cosine, serverless).
PINECONE_INDEX=peopleprime-hr-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Namespaces. Writer and reader read the same value, so changing one of these
# means re-ingesting -- a mismatch is silent, because the upsert succeeds and
# every later retrieval simply returns [].
# PRIVATE_NAMESPACE=hr-docs
# PUBLIC_NAMESPACE=public-web

# Optional overrides -- all have working defaults. Set them explicitly in a
# deployment so the running configuration is readable from the environment
# rather than inferred from the code.
# GROQ_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# API_HOST=0.0.0.0
# API_PORT=8000

# --- Observability -----------------------------------------------------------
# LangSmith tracing is OFF unless LANGSMITH_TRACING is true AND a key is set.
# /health reports both whether tracing is on and whether it is redacted.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=<your-langsmith-key>
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=hr-copilot

# Payload redaction, ON by default and the reason tracing is safe to enable
# here. Without it every trace uploads the employee's question and the retrieved
# policy text to LangChain. With it you still get the run tree, timings, routing
# and grading decisions, token counts and errors -- everything needed to debug
# the agent -- and no HR content.
#
# Turn them off only to debug a specific answer, and turn them back on.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Note: OPENAI_API_KEY is only forwarded to the process environment when
# LLM_PROVIDER or EMBEDDING_PROVIDER is set to openai. A key left here while
# both providers are their defaults stays unused -- it is never exported, so
# langchain-openai (installed as a langchain-pinecone dependency) cannot pick
# it up on its own.

# =============================================================================
# The production layers around the agent. Everything below has a working
# default; the point of listing it is that a deployment's behaviour should be
# readable from its environment rather than inferred from the code.
# =============================================================================

# --- Roles -------------------------------------------------------------------
# A second role between employee and admin. HR staff need to upload policy and
# decide approvals; they do not need to read every employee's question out of
# the audit log, and one key with one role could not express that.
#
# Empty means the role CANNOT BE ASSUMED -- including by a request presenting an
# empty header. See POLICY in app/services/authorization.py for what each role
# actually holds.
# HR_API_KEY=

# --- Retrieval ---------------------------------------------------------------
#   RETRIEVAL_MODE=auto      resolves to the best mode this deployment can
#                            serve: hybrid with a Pinecone key, lexical without.
#   RETRIEVAL_MODE=dense     Pinecone only. The behaviour this project shipped
#                            with.
#   RETRIEVAL_MODE=lexical   BM25 over the knowledge base on disk. No keys, no
#                            network, no embedding model. This is what makes a
#                            keyless public demo answer anything at all.
#   RETRIEVAL_MODE=hybrid    both, fused with reciprocal rank fusion.
#
# `auto` degrades DOWNWARDS: an explicit `dense` on a deployment with no
# Pinecone key also resolves to lexical, because the alternative is every
# question returning nothing while /health reports the mode you asked for.
# RETRIEVAL_MODE=auto
# HYBRID_DENSE_WEIGHT=0.6
# RRF_K=60

# Re-ranking reorders a wider candidate list before the generator sees it.
# Retrieval ranks by similarity to the QUESTION, which is not the same as
# answering it -- measured here, a wrong-source chunk scored 0.521 while the
# lowest correct one scored 0.171.
#   lexical  term-overlap, offline, free, deterministic. The default.
#   llm      the model scores each candidate. Better, costs a call per question.
#   none     keep the fused order.
# RERANK_STRATEGY=lexical
# RERANK_CANDIDATES=12

# Few-shot grading: the same grader instruction plus four labelled examples.
# OFF by default, and that is deliberate rather than an omission -- GRADER_PROMPT
# is what the 0.15 gate and the 21/21 labelled set were measured against, and
# switching the prompt invalidates both numbers at once with no way to tell
# which change moved which figure. This is the A/B switch, not an improvement
# already made.
# FEWSHOT_GRADING=false

# --- Semantic cache ----------------------------------------------------------
# The most dangerous cache in this product: two questions that are semantically
# close can have different correct answers. How much PTO do I get, and how much
# PTO do contractors get, differ by one word and by the entire answer. Hence a
# high threshold and a short TTL -- policy changes, and a stale HR answer is a
# wrong answer with a citation attached.
# CACHE_ENABLED=true
# CACHE_SIMILARITY=0.95
# CACHE_TTL_SECONDS=900
# CACHE_MAX_ENTRIES=512

# --- Model routing -----------------------------------------------------------
# Picks a cheaper model for a question that does not need a better one. Leave
# the tier models empty to collapse the ladder onto the configured model, which
# is what to do while measuring whether routing hurt quality.
# MODEL_ROUTING_ENABLED=true
# FAST_MODEL=
# DEEP_MODEL=

# --- Orchestration -----------------------------------------------------------
#   graph       the 11-node pipeline. Deterministic and cheapest.
#   react       a tool-choosing loop over the tool registry.
#   supervisor  a supervisor delegating to specialist workers.
#   auto        graph, or supervisor when a question spans policy areas.
#
# `auto` only reaches for the supervisor on a question classify_complexity calls
# complex, because a supervisor run is one delegation call per hop plus one
# generation per worker plus a composition -- which is the wrong thing to spend
# on a question about core hours.
# AGENT_MODE=auto

# --- Budgets -----------------------------------------------------------------
# Five ceilings rather than one, because an agent can hit any of them first and
# they fail differently. A budget is a STOPPING CONDITION, not an error: the run
# composes the best answer it has and says it is partial.
# MAX_AGENT_STEPS=8
# MAX_TOOL_CALLS=12
# MAX_LLM_CALLS=16
# MAX_AGENT_TOKENS=120000
# MAX_AGENT_SECONDS=45
# MAX_AGENT_COST_USD=0.25
# MAX_HANDOFFS=4

# Set MAX_AGENT_SECONDS below any platform request timeout. A budget that
# outlives its function produces a request killed mid-answer, which a client
# reports as a cut stream rather than as a slow one.

# --- Tools -------------------------------------------------------------------
# Ceilings rather than defaults: a ToolSpec carries its own and the registry
# takes min(spec, setting), so a tool that forgets its own timeout still cannot
# hang the request.
# TOOL_TIMEOUT_SECONDS=20
# TOOL_RETRIES=2
# TOOL_BACKOFF_SECONDS=0.4
# TOOL_PARALLELISM=4

# --- Guardrails --------------------------------------------------------------
# This product invites employees to describe their own situation, so a question
# carrying a salary figure, a phone number or a national id is the normal case.
# Redaction happens once, at the edge, before the question reaches a provider,
# the vector index or the audit log.
#
# AUDIT_STORES_REDACTED=false keeps the employee's verbatim wording in the
# compliance record. That costs an investigator nothing and makes the audit log
# the place the personal data ended up.
# INPUT_GUARD=true
# OUTPUT_GUARD=true
# REDACT_PII=true
# AUDIT_STORES_REDACTED=true

# --- Bring your own key ------------------------------------------------------
# A visitor supplies their own provider key and their questions are answered on
# their account, with no shared-key rate limit. The key is used to build one
# chat client, is never written to the audit log, a span, a log line or the
# vector index, and only ever reaches the chat model -- never Pinecone and never
# the web search.
#
# Set ALLOW_BYOK=false on an internal deployment that wants every answer on the
# company's own account.
# ALLOW_BYOK=true
# BYOK_POOL_SIZE=8

# --- Rate limiting -----------------------------------------------------------
# Guards the DEPLOYMENT'S OWN key. A caller spending their own is not spending
# yours, and an authenticated admin is operating the deployment rather than
# consuming it -- neither is limited.
#
# Scope is one process. On a platform that runs several instances the effective
# limit is instances x rate; a real limit belongs in front of this application.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_BURST=5

# --- Public demo -------------------------------------------------------------
# Turns on what a deployment anyone can reach needs and an internal one does
# not: the key panel is offered, the shared-key quota is advertised rather than
# hidden, and the console says plainly which model answered.
# PUBLIC_DEMO=false

# --- In-process tracing ------------------------------------------------------
# The local half of the observability split: a span tree built in the request,
# returned on the response and rendered in the console. No key, no third party.
#
# TRACE_PAYLOADS defaults to OFF for the same reason the LangSmith redaction
# above defaults to ON -- spans are serialised onto an HTTP response and written
# to the audit row, so an attribute holding policy text is that text in a second
# place nobody accounted for.
# TRACE_SPANS=true
# TRACE_PAYLOADS=false

# --- Working state -----------------------------------------------------------
# The scratchpad, the approval queue, remembered facts and the idempotency
# ledger. A SEPARATE file from the audit log on purpose: the audit log is the
# compliance record and must not share a backup policy with a table that churns
# on every request.
# STATE_DB_PATH=/app/var/state.db
