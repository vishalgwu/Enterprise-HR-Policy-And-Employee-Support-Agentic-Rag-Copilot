# Copy to .env and fill in real values. .env is gitignored -- never commit it.
#
# Only the three API keys are required. Everything below them has a working
# default, and the app starts without the keys so /health can report which are
# missing by name.

# https://console.groq.com/keys
GROQ_API=<your-groq-api-key>

# https://app.tavily.com
TAVILY_API=<your-tavily-api-key>

# https://app.pinecone.io
PINECONE_API=<your-pinecone-api-key>

# The index is created automatically on first run (384-d, cosine, serverless).
PINECONE_INDEX=peopleprime-hr-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Namespaces. Writer and reader read the same value, so changing one of these
# means re-ingesting -- a mismatch is silent, because the upsert succeeds and
# every later retrieval simply returns [].
# PRIVATE_NAMESPACE=hr-docs
# PUBLIC_NAMESPACE=public-web

# Optional overrides -- all have working defaults. Set them explicitly in a
# deployment so the running configuration is readable from the environment
# rather than inferred from the code.
# GROQ_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# API_HOST=0.0.0.0
# API_PORT=8000

# --- Observability -----------------------------------------------------------
# LangSmith tracing is OFF unless LANGSMITH_TRACING is true AND a key is set.
#
# Think before enabling it in production: tracing uploads every question and
# every retrieved chunk to LangChain's servers. For this product that means
# employee HR questions and internal policy text leaving the deployment.
# /health reports whether it is on.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=<your-langsmith-key>
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=hr-copilot

# Note: nothing in this project uses OpenAI. Embeddings run locally on
# all-MiniLM-L6-v2 and generation runs on Groq. `openai` and `langchain-openai`
# are installed only because langchain-pinecone requires them. Do not set
# OPENAI_API_KEY -- it would be picked up by a library this project does not use.
