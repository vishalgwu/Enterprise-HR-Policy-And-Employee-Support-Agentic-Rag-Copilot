# Keep binaries byte-exact -- core.autocrlf would otherwise rewrite line endings
*.pdf binary
*.png binary
*.jpg binary
*.ico binary

# Files a Linux container reads. core.autocrlf=true is on this machine, so
# without these they would be checked out CRLF; anything that ends up executed
# by a shell inside the image (an entrypoint, a helper script) fails on the
# stray CR with "not found", naming the interpreter rather than the cause.
# Pinning LF here costs nothing and removes the whole class.
Dockerfile      text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
