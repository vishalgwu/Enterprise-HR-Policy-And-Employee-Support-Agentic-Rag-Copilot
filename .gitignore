# Secrets -- never commit real credentials
.env
.env.*
!.env.example

# Virtual environments
hr/
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
build/
dist/

# Editors / IDEs
.idea/
.vscode/
# Editor and tool workspace state, alongside .idea/ and .vscode/. launch.json
# there hardcodes this machine's venv path, so it is not shareable.
.claude/
.cursor/

# Local logs and scratch output
*.log

# Employee-uploaded documents -- runtime data, not source
uploads/*
!uploads/.gitkeep

# The audit log -- every employee question and the answer they were given.
# Runtime data, and HR-sensitive; never source.
*.db
*.db-wal
*.db-shm
*.sqlite3

# Added by `vercel link`. `.vercel/` holds the project id and `.env.local` the
# OIDC token it downloads -- both are per-machine and neither belongs in the
# repository.
.vercel
.env*
# But not the template. `.env.example` is tracked, so the pattern above does not
# currently hide it -- gitignore does not affect an already-tracked file -- and
# this is here so that stays true if it is ever removed and re-added.
!.env.example
